generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

model Person {
  id                    String                 @id @default(uuid())
  name                  String
  createdAt             DateTime               @default(now())
  creditCardPurchases   CreditCardPurchase[]
  loyaltyTransactions   LoyaltyTransaction[]
  loyaltyTransfers      LoyaltyTransfer[]
  recurringTransactions RecurringTransaction[]
  transactions          Transaction[]
}

model Category {
  id                    String                    @id @default(uuid())
  name                  String                    @unique(map: "categories_root_name_unique", where: raw("(\"parentId\" IS NULL)"))
  parentId              String?
  createdAt             DateTime                  @default(now())
  level                 Int                       @default(0)
  path                  String?                   @default("")
  parent                Category?                 @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children              Category[]                @relation("CategoryHierarchy")
  creditCardPurchases   CreditCardPurchase[]
  merchantHistory       MerchantCategoryHistory[]
  recurringTransactions RecurringTransaction[]
  transactions          Transaction[]
}

model MerchantCategoryHistory {
  id          String   @id @default(uuid())
  merchantKey String   @unique
  categoryId  String
  usageCount  Int      @default(1)
  updatedAt   DateTime @updatedAt
  category    Category @relation(fields: [categoryId], references: [id])
}

model CreditCard {
  id               String               @id @default(uuid())
  name             String
  closureType      ClosureType
  fixedClosureDay  Int?
  dueDayOfMonth    Int
  alwaysNextMonth  Boolean              @default(false)
  createdAt        DateTime             @default(now())
  closureNextMonth Boolean              @default(false)
  closures         CreditCardClosure[]
  purchases        CreditCardPurchase[]
}

model CreditCardClosure {
  id            String     @id @default(uuid())
  creditCardId  String
  year          Int
  month         Int
  closureDay    Int
  previousMonth Boolean    @default(false)
  creditCard    CreditCard @relation(fields: [creditCardId], references: [id], onDelete: Cascade)

  @@unique([creditCardId, year, month])
}

model Transaction {
  id            String          @id @default(uuid())
  personId      String
  type          TransactionType
  amount        Decimal         @db.Decimal(15, 2)
  date          DateTime
  description   String
  paymentMethod PaymentMethod?
  categoryId    String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  source        IncomeSource?
  category      Category?       @relation(fields: [categoryId], references: [id])
  person        Person          @relation(fields: [personId], references: [id], onDelete: Cascade)
}

model CreditCardPurchase {
  id                   String        @id @default(uuid())
  personId             String
  description          String
  totalAmount          Decimal       @db.Decimal(15, 2)
  numberOfInstallments Int
  purchaseDate         DateTime
  categoryId           String?
  createdAt            DateTime      @default(now())
  creditCardId         String?
  category             Category?     @relation(fields: [categoryId], references: [id])
  creditCard           CreditCard?   @relation(fields: [creditCardId], references: [id])
  person               Person        @relation(fields: [personId], references: [id], onDelete: Cascade)
  installments         Installment[]
}

model Installment {
  id                   String             @id @default(uuid())
  creditCardPurchaseId String
  installmentNumber    Int
  amount               Decimal            @db.Decimal(15, 2)
  dueYear              Int
  dueMonth             Int
  isPaid               Boolean            @default(false)
  isCanceled           Boolean            @default(false)
  creditCardPurchase   CreditCardPurchase @relation(fields: [creditCardPurchaseId], references: [id], onDelete: Cascade)

  @@unique([creditCardPurchaseId, installmentNumber])
}

model RecurringTransaction {
  id            String          @id @default(uuid())
  personId      String
  type          TransactionType
  amount        Decimal         @db.Decimal(15, 2)
  description   String
  paymentMethod PaymentMethod
  categoryId    String?
  startDate     DateTime
  endDate       DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  frequency     FrequencyType   @default(MONTHLY)
  category      Category?       @relation(fields: [categoryId], references: [id])
  person        Person          @relation(fields: [personId], references: [id], onDelete: Cascade)
}

enum TransactionType {
  INCOME
  EXPENSE
  INVESTMENT
}

enum PaymentMethod {
  CASH
  DEBIT_CARD
  CREDIT_CARD
  PIX
  BANK_TRANSFER
  BOLETO
  ACCOUNT_DEBIT
}

enum IncomeSource {
  SALARY
  FREELANCE
  RENTAL
  INVESTMENT
  OTHER
}

enum FrequencyType {
  MONTHLY
}

enum ClosureType {
  FIXED
  VARIABLE
}

enum LoyaltyProgramType {
  AIRLINE
  HOTEL
  BANK
  OTHER
}

enum LoyaltyTransactionType {
  PURCHASE
  EARN
  BONUS
  REDEEM
  TRANSFER_OUT
  TRANSFER_IN
  EXPIRE
  ADJUSTMENT
}

model LoyaltyProgram {
  id           String               @id @default(uuid())
  name         String
  type         LoyaltyProgramType
  color        String
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  transactions LoyaltyTransaction[]
  transfersFrom LoyaltyTransfer[]   @relation("TransferFrom")
  transfersTo   LoyaltyTransfer[]   @relation("TransferTo")
}

model LoyaltyTransfer {
  id             String               @id @default(uuid())
  fromProgramId  String
  toProgramId    String
  pointsSent     Float
  pointsReceived Float
  costBrl        Float?
  transferDate   DateTime
  personId       String?
  description    String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  fromProgram    LoyaltyProgram       @relation("TransferFrom", fields: [fromProgramId], references: [id])
  toProgram      LoyaltyProgram       @relation("TransferTo", fields: [toProgramId], references: [id])
  person         Person?              @relation(fields: [personId], references: [id])
  transactions   LoyaltyTransaction[]
}

model LoyaltyTransaction {
  id          String                 @id @default(uuid())
  programId   String
  personId    String?
  transferId  String?
  type        LoyaltyTransactionType
  points      Float
  date        DateTime
  description String?
  expiresAt   DateTime?
  costBrl     Float?
  valueBrl    Float?
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  program     LoyaltyProgram         @relation(fields: [programId], references: [id])
  person      Person?                @relation(fields: [personId], references: [id])
  transfer    LoyaltyTransfer?       @relation(fields: [transferId], references: [id], onDelete: Cascade)
}
