generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

model Person {
  id                    String                 @id @default(uuid())
  name                  String
  createdAt             DateTime               @default(now())
  creditCardPurchases   CreditCardPurchase[]
  recurringTransactions RecurringTransaction[]
  transactions          Transaction[]
}

model Category {
  id                    String                 @id @default(uuid())
  name                  String                 @unique(map: "categories_root_name_unique", where: raw("(\"parentId\" IS NULL)"))
  parentId              String?
  createdAt             DateTime               @default(now())
  level                 Int                    @default(0)
  path                  String?                @default("")
  parent                Category?              @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children              Category[]             @relation("CategoryHierarchy")
  creditCardPurchases   CreditCardPurchase[]
  recurringTransactions RecurringTransaction[]
  transactions          Transaction[]
}

model CreditCard {
  id               String               @id @default(uuid())
  name             String
  closureType      ClosureType
  fixedClosureDay           Int?
  fixedClosurePreviousMonth Boolean              @default(false)
  dueDayOfMonth             Int
  alwaysNextMonth           Boolean              @default(false)
  createdAt                 DateTime             @default(now())
  closureNextMonth          Boolean              @default(false)
  closures         CreditCardClosure[]
  purchases        CreditCardPurchase[]
}

model CreditCardClosure {
  id            String     @id @default(uuid())
  creditCardId  String
  year          Int
  month         Int
  closureDay    Int
  previousMonth Boolean    @default(false)
  creditCard    CreditCard @relation(fields: [creditCardId], references: [id], onDelete: Cascade)

  @@unique([creditCardId, year, month])
}

model Transaction {
  id            String          @id @default(uuid())
  personId      String
  type          TransactionType
  amount        Decimal         @db.Decimal(15, 2)
  date          DateTime
  description   String
  paymentMethod PaymentMethod?
  categoryId    String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  source        IncomeSource?
  category      Category?       @relation(fields: [categoryId], references: [id])
  person        Person          @relation(fields: [personId], references: [id], onDelete: Cascade)
}

model CreditCardPurchase {
  id                   String        @id @default(uuid())
  personId             String
  description          String
  totalAmount          Decimal       @db.Decimal(15, 2)
  numberOfInstallments Int
  purchaseDate         DateTime
  categoryId           String?
  createdAt            DateTime      @default(now())
  creditCardId         String?
  category             Category?     @relation(fields: [categoryId], references: [id])
  creditCard           CreditCard?   @relation(fields: [creditCardId], references: [id])
  person               Person        @relation(fields: [personId], references: [id], onDelete: Cascade)
  installments         Installment[]
}

model Installment {
  id                   String             @id @default(uuid())
  creditCardPurchaseId String
  installmentNumber    Int
  amount               Decimal            @db.Decimal(15, 2)
  dueYear              Int
  dueMonth             Int
  isPaid               Boolean            @default(false)
  isCanceled           Boolean            @default(false)
  creditCardPurchase   CreditCardPurchase @relation(fields: [creditCardPurchaseId], references: [id], onDelete: Cascade)

  @@unique([creditCardPurchaseId, installmentNumber])
}

model RecurringTransaction {
  id            String          @id @default(uuid())
  personId      String
  type          TransactionType
  amount        Decimal         @db.Decimal(15, 2)
  description   String
  paymentMethod PaymentMethod
  categoryId    String?
  startDate     DateTime
  endDate       DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  frequency     FrequencyType   @default(MONTHLY)
  category      Category?       @relation(fields: [categoryId], references: [id])
  person        Person          @relation(fields: [personId], references: [id], onDelete: Cascade)
}

enum TransactionType {
  INCOME
  EXPENSE
  INVESTMENT
}

enum PaymentMethod {
  CASH
  DEBIT_CARD
  CREDIT_CARD
  PIX
  BANK_TRANSFER
  BOLETO
  ACCOUNT_DEBIT
}

enum IncomeSource {
  SALARY
  FREELANCE
  RENTAL
  INVESTMENT
  OTHER
}

enum FrequencyType {
  MONTHLY
}

enum ClosureType {
  FIXED
  VARIABLE
}
