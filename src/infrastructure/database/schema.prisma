generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum TransactionType {
  INCOME
  EXPENSE
  INVESTMENT
}

enum PaymentMethod {
  CASH
  DEBIT_CARD
  CREDIT_CARD
  PIX
  BANK_TRANSFER
  BOLETO
  ACCOUNT_DEBIT
}

enum IncomeSource {
  SALARY
  FREELANCE
  RENTAL
  INVESTMENT
  OTHER
}

enum FrequencyType {
  MONTHLY
}

enum ClosureType {
  FIXED
  VARIABLE
}

model Person {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())

  transactions          Transaction[]
  creditCardPurchases   CreditCardPurchase[]
  recurringTransactions RecurringTransaction[]
}

model Category {
  id        String   @id @default(uuid())
  name      String
  parentId  String?
  path      String   @default("")
  level     Int      @default(0)
  createdAt DateTime @default(now())

  parent                Category?              @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children              Category[]             @relation("CategoryHierarchy")
  transactions          Transaction[]
  recurringTransactions RecurringTransaction[]
  creditCardPurchases   CreditCardPurchase[]
}

model CreditCard {
  id               String      @id @default(uuid())
  name             String
  closureType      ClosureType
  fixedClosureDay  Int?
  dueDayOfMonth    Int
  alwaysNextMonth  Boolean     @default(false)
  closureNextMonth Boolean     @default(false)
  createdAt        DateTime    @default(now())

  purchases CreditCardPurchase[]
  closures  CreditCardClosure[]
}

model CreditCardClosure {
  id            String     @id @default(uuid())
  creditCardId  String
  year          Int
  month         Int
  closureDay    Int
  previousMonth Boolean    @default(false)

  creditCard CreditCard @relation(fields: [creditCardId], references: [id], onDelete: Cascade)

  @@unique([creditCardId, year, month])
}

model Transaction {
  id            String          @id @default(uuid())
  personId      String
  type          TransactionType
  amount        Decimal         @db.Decimal(15, 2)
  date          DateTime
  description   String
  paymentMethod PaymentMethod?
  source        IncomeSource?
  categoryId    String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  person   Person    @relation(fields: [personId], references: [id], onDelete: Cascade)
  category Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
}

model CreditCardPurchase {
  id                   String   @id @default(uuid())
  personId             String
  creditCardId         String?
  description          String
  totalAmount          Decimal  @db.Decimal(15, 2)
  numberOfInstallments Int
  purchaseDate         DateTime
  categoryId           String?
  createdAt            DateTime @default(now())

  person       Person        @relation(fields: [personId], references: [id], onDelete: Cascade)
  creditCard   CreditCard?   @relation(fields: [creditCardId], references: [id])
  category     Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  installments Installment[]
}

model Installment {
  id                   String  @id @default(uuid())
  creditCardPurchaseId String
  installmentNumber    Int
  amount               Decimal @db.Decimal(15, 2)
  dueYear              Int
  dueMonth             Int
  isPaid               Boolean @default(false)
  isCanceled           Boolean @default(false)

  creditCardPurchase CreditCardPurchase @relation(fields: [creditCardPurchaseId], references: [id], onDelete: Cascade)

  @@unique([creditCardPurchaseId, installmentNumber])
}

model RecurringTransaction {
  id            String          @id @default(uuid())
  personId      String
  type          TransactionType
  amount        Decimal         @db.Decimal(15, 2)
  description   String
  paymentMethod PaymentMethod
  categoryId    String?
  frequency     FrequencyType   @default(MONTHLY)
  startDate     DateTime
  endDate       DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  person   Person    @relation(fields: [personId], references: [id], onDelete: Cascade)
  category Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
}
