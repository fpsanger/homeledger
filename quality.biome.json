{
  "$schema": "https://biomejs.dev/schemas/2.4.14/schema.json",
  "files": {
    "includes": ["src/**"]
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": false,
      "complexity": {
        "noExcessiveLinesPerFunction": {
          "level": "warn",
          "options": {
            "maxLines": 80
          }
        }
      },
      "nursery": {
        "noExcessiveLinesPerFile": {
          "level": "warn",
          "options": {
            "maxLines": 400
          }
        }
      }
    }
  }
}
